# ==============================================================================
# PAMM PLATFORM TEST AUTOMATION CONFIGURATION
# Copy this file to '.env' and fill in your real test credentials.
# '.env' is automatically ignored by git to protect your credentials.
# ==============================================================================

# Target Platform Base URL (Client Portal or Admin Backoffice)
PLATFORM_BASE_URL=https://lpadmin.blackfx.com

# Master Strategy & Pool Configuration
MASTER_ACCOUNT_ID=PAMMASTER2
MANAGER_SHARE_PERCENT=20

# Test Account Credentials (Use Demo or Staging Accounts)
ADMIN_USERNAME=your_test_admin_or_master_user
ADMIN_PASSWORD=your_test_password

# Optional: Direct Bearer Token or Session Cookie (if bypassing login form)
AUTH_BEARER_TOKEN=
SESSION_COOKIE=

# Automation Controls
TEST_FOLLOWER_COUNT=100
MAX_CONCURRENT_THREADS=25
HEADLESS_BROWSER=true

